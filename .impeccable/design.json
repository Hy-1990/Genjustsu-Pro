      "Near-black tonal layers with icy cyan action and selection.",
      "Compact native typography; monospace reserved for elapsed measurement.",
      "Thin connected stages with motion tied to actual execution."
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "Cyan marks action, selection and active work; green marks approved or complete states; rose marks actionable failure. Every pipeline state also has text.",
        "section": "colors"
      },
      {
        "name": "The Measurement Rule",
        "body": "Use monospace for elapsed measurement; use the native bilingual sans stack for workspace titles, labels and controls.",
        "section": "typography"
