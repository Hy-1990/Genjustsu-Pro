  "components": [
    {
      "name": "Generate finished video",
      "kind": "button",
      "refersTo": "day-button-primary",
      "description": "Active-theme primary action; night colors inherit the same semantic variables.",
      "html": "<button class=\"ds-button-primary\">Generate finished video</button>",
      "css": ".ds-button-primary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:12px;border:0;border-radius:9px;padding:10px 14px;font-weight:550;cursor:pointer;transition:background .18s,color .18s,transform .18s;background:var(--primary,#215e4f);color:var(--primary-ink,#ffffff);}.ds-button-primary:hover{background:var(--primary-hover,#164d3f);}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#317d65);outline-offset:3px;}.ds-button-primary:active:not(:disabled){transform:translateY(1px)}.ds-button-primary:disabled{opacity:.48;cursor:not-allowed}"
    },
