  "narrative": {
    "northStar": "The Technical Product Catalog",
    "overview": "Cool stone surfaces, deep blue ink and restrained cobalt selection give this local video tool the calm precision of a technical product catalog. The interface is compact and task-led: media, controls and processing state share a working surface.\n\nWhite containers separate editable materials from inspection. Standard web controls, bilingual labels and explicit status text keep the visual language practical. Color distinguishes action, selection, success and failure; it does not decorate the workspace.",
    "keyCharacteristics": [
      "Cool neutral layers with cobalt action and selection.",
      "Compact, aligned controls and readable media.",
      "State and recovery adjacent to the task."
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "Cobalt marks action and selection; green marks approved or complete states; red marks actionable failure. Every state also has text.",
        "section": "colors"
      },
      {
        "name": "The Task Order Rule",
        "body": "At single-column widths, materials lead until guidance exists; then the viewer leads for inspection.",
        "section": "layout"
      },
      {
        "name": "The Tonal Separation Rule",
        "body": "Panels stay flat at rest; fine borders and neutral fills establish containment. Toasts alone use the shipped floating shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use cobalt for primary actions and selected inspection controls.",
      "Do pair status colors with explicit text.",
      "Do let Chinese and English labels wrap where space is constrained.",
      "Do keep review, progress and recovery beside the viewer.",
      "Do retain native video controls and the current inspection time when metadata permits."
    ],
    "donts": [
      "Don't make all actions primary; use secondary, quiet and text treatments for supporting actions.",
      "Don't apply container shadows; separation comes from tone and fine borders.",
      "Don't put an empty viewer ahead of materials in the single-column initial state.",
      "Don't hide guidance behind the materials once guidance exists in the single-column workspace.",
      "Don't infer successful paid generation from the synthetic review screenshots."
    ]
  }
}
